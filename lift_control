#!/usr/bin/env python3
"""
Tang Nano 20K Servo Driver - ROS 2 Humble
Puente entre ROS 2 y la Tang Nano 20K vía UART.

Tópicos suscritos:
  /servo_angles     (Int32MultiArray) — control directo [s1, s2], valores 0-180
  /servo_command    (String)          — comandos por flags: "LIFT_UP", "LIFT_DOWN", "STOP"

Formato UART: "S1:90 S2:90\n"
  90  = parado (neutro MG90S 360°)
  0   = velocidad máxima CW
  180 = velocidad máxima CCW
"""

import rclpy
from rclpy.node import Node
from std_msgs.msg import Int32MultiArray, String
import serial


# ─── Mapa de comandos por flag ───────────────────────────────────────────────
# Aquí agregas los estados que necesite tu lift.
# Formato: "NOMBRE_FLAG": [angulo_servo1, angulo_servo2]
COMMAND_MAP = {
    "LIFT_UP":   [180, 180],  # Ambos CCW = sube
    "LIFT_DOWN": [0,   0],    # Ambos CW  = baja
    "STOP":      [90,  90],   # Neutro     = para
}


class TangServoDriver(Node):

    def __init__(self):
        super().__init__('tang_servo_driver')

        # ─── Parámetros ──────────────────────────────────────────────────────
        self.declare_parameter('port',      '/dev/ttyTHS1')
        self.declare_parameter('baudrate',  115200)
        self.declare_parameter('num_servos', 2)
        self.declare_parameter('angle_min',  0)
        self.declare_parameter('angle_max',  180)
        self.declare_parameter('watchdog_timeout', 1.0)  # segundos

        port     = self.get_parameter('port').value
        baud     = self.get_parameter('baudrate').value
        self.num_servos       = self.get_parameter('num_servos').value
        self.angle_min        = self.get_parameter('angle_min').value
        self.angle_max        = self.get_parameter('angle_max').value
        self.watchdog_timeout = self.get_parameter('watchdog_timeout').value

        # ─── Puerto serie ────────────────────────────────────────────────────
        self.serial_conn = None
        try:
            self.serial_conn = serial.Serial(port, baud, timeout=1)
            self.get_logger().info(f'UART conectado en {port} @ {baud} baud')
        except serial.SerialException as e:
            # FIX: no hacemos sys.exit — dejamos que ROS 2 maneje el ciclo de vida
            self.get_logger().error(f'No se pudo abrir {port}: {e}')

        # ─── Suscripciones ───────────────────────────────────────────────────
        self.create_subscription(
            Int32MultiArray,
            'servo_angles',
            self.angle_callback,
            10)

        # FIX NUEVO: tópico de flags para teleop / reconocimiento de voz
        self.create_subscription(
            String,
            'servo_command',
            self.command_callback,
            10)

        # ─── Watchdog ────────────────────────────────────────────────────────
        self.last_msg_time = self.get_clock().now()
        self.watchdog_active = False  # Solo activa watchdog tras primer mensaje
        self.create_timer(0.5, self.watchdog_callback)

        self.get_logger().info('Driver listo. Tópicos: /servo_angles | /servo_command')

    # ─── Callback: ángulos directos ──────────────────────────────────────────
    def angle_callback(self, msg):
        """
        Recibe array de ángulos [s1, s2] en 0-180.
        Útil para control fino o teleop analógico.
        """
        if len(msg.data) != self.num_servos:
            self.get_logger().warn(
                f'Se esperaban {self.num_servos} ángulos, recibidos {len(msg.data)}. Ignorando.')
            return

        angles = [max(self.angle_min, min(self.angle_max, a)) for a in msg.data]
        self._send(angles)

    # ─── Callback: flags de comando ──────────────────────────────────────────
    def command_callback(self, msg):
        """
        Recibe un string flag y lo traduce a ángulos según COMMAND_MAP.
        Ejemplo: "LIFT_UP", "LIFT_DOWN", "STOP"
        Aquí conectarás el HMM de reconocimiento de voz y el teleop.
        """
        cmd = msg.data.strip().upper()

        if cmd not in COMMAND_MAP:
            self.get_logger().warn(
                f'Comando desconocido: "{cmd}". Disponibles: {list(COMMAND_MAP.keys())}')
            return

        angles = COMMAND_MAP[cmd]
        self.get_logger().info(f'Comando recibido: {cmd} → {angles}')
        self._send(angles)

    # ─── Watchdog ────────────────────────────────────────────────────────────
    def watchdog_callback(self):
        """
        Si pasan más de watchdog_timeout segundos sin mensajes, centra servos.
        Solo actúa tras haber recibido al menos un mensaje (evita spam al arrancar).
        """
        if not self.watchdog_active:
            return

        elapsed = (self.get_clock().now() - self.last_msg_time).nanoseconds / 1e9
        if elapsed > self.watchdog_timeout:
            center = (self.angle_min + self.angle_max) // 2
            self.get_logger().warn(
                f'Watchdog: {elapsed:.1f}s sin comandos. Centrando servos.')
            self._send([center] * self.num_servos)
            self.watchdog_active = False  # Evita spam de logs mientras sigue inactivo

    # ─── Envío UART ──────────────────────────────────────────────────────────
    def _send(self, angles: list):
        """
        Construye y envía el comando UART.
        FIX: verifica que el puerto esté abierto antes de escribir.
        """
        if self.serial_conn is None or not self.serial_conn.is_open:
            self.get_logger().error('Puerto serie no disponible. Comando descartado.')
            return

        cmd = ' '.join([f'S{i+1}:{a}' for i, a in enumerate(angles)]) + '\n'
        try:
            self.serial_conn.write(cmd.encode('ascii'))
            self.get_logger().debug(f'Enviado: {cmd.strip()}')
        except serial.SerialException as e:
            self.get_logger().error(f'Error UART al enviar: {e}')

        self.last_msg_time = self.get_clock().now()
        self.watchdog_active = True

    # ─── Destructor ──────────────────────────────────────────────────────────
    def destroy_node(self):
        """
        FIX: cierre seguro — verifica que serial_conn existe antes de cerrar.
        """
        if self.serial_conn is not None and self.serial_conn.is_open:
            self._send([90, 90])  # Centra servos al apagar el nodo
            self.serial_conn.close()
            self.get_logger().info('Puerto serie cerrado.')
        super().destroy_node()


def main(args=None):
    rclpy.init(args=args)
    node = TangServoDriver()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()