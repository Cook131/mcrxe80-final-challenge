#!/usr/bin/env python3
"""
ArUco Detector Triple-Diccionario + QR Node para Puzzlebot - Manchester Robotics

Detecta marcadores usando TRES diccionarios en paralelo + QR codes:
  - Diccionario custom "16h3"  → Internal WP 1, 2, 3
  - Diccionario 4X4_50         → External WP 0, 1, 2, 3
  - Diccionario 6X6_50 IDs 0-6 → Waypoint_0 … Waypoint_6
  - QR codes                   → contenido del QR como string

Tópicos:
  Suscribe:  /camera/image_raw/compressed  (sensor_msgs/msg/CompressedImage)
  Publica:   /aruco/id                     (std_msgs/msg/Int32)
             /aruco/label                  (std_msgs/msg/String)
             /aruco/imagen                 (sensor_msgs/msg/Image)
             /aruco/waypoint               (geometry_msgs/msg/PoseStamped)
             /aruco/qr                     (std_msgs/msg/String)  ← contenido QR

IDs publicados en /aruco/id:
  -1           → ningún marcador detectado
  11, 12, 13   → Internal WP 1/2/3      (16h3)
  20, 21, 22, 23 → External WP 0-3     (4X4_50)
  30, 31 … 36  → Waypoint_0 … _6       (6X6_50)

Calibración:
  Busca automáticamente camera_params.npz o camera_params.json
  en la misma carpeta que este script.
"""

import json
import os
import tempfile

import cv2
import numpy as np

import rclpy
from rclpy.node import Node
from rclpy.qos import HistoryPolicy, QoSProfile, ReliabilityPolicy

from cv_bridge import CvBridge
from geometry_msgs.msg import PoseStamped
from sensor_msgs.msg import CompressedImage, Image
from std_msgs.msg import Int32, String

# ─────────────────────────────────────────────────────────────────────
# YAML embebido diccionario custom "16h3"
# ─────────────────────────────────────────────────────────────────────
CUSTOM_16H3_YAML = """%YAML:1.0
---
nmarkers: 3
markersize: 4
maxCorrectionBits: 0
marker_0: "1000101100000011"
marker_1: "0010010100110111"
marker_2: "1011011011000111"
"""

# ─────────────────────────────────────────────────────────────────────
# Mapas de etiquetas
# ─────────────────────────────────────────────────────────────────────
ID_ORDER_INTERNAL = [1, 2, 3]

LABEL_INTERNAL = {
    1: "Internal WP 1",
    2: "Internal WP 2",
    3: "Internal WP 3",
}

LABEL_EXTERNAL = {
    0: "External WP 0",
    1: "External WP 1",
    2: "External WP 2",
    3: "External WP 3",
}

# 6X6_50: IDs 0-6 → Waypoint_0 … Waypoint_6
WAYPOINT_6X6_IDS = set(range(7))  # {0,1,2,3,4,5,6}

def label_6x6(mid: int) -> str:
    return f"Waypoint_{mid}"

# IDs únicos publicados en /aruco/id
def internal_pub_id(orig_id: int) -> int:  return 10 + orig_id   # 11-13
def external_pub_id(marker_id: int) -> int: return 20 + marker_id # 20-23
def waypoint_pub_id(mid: int) -> int:       return 30 + mid       # 30-36

# ─────────────────────────────────────────────────────────────────────
# Calibración
# ─────────────────────────────────────────────────────────────────────
_KEY_K = ["camera_matrix", "K", "mtx", "cameraMatrix", "intrinsic"]
_KEY_D = ["dist_coeffs",   "D", "dist", "distCoeffs",  "distortion"]

def _find_key(data, aliases):
    for k in aliases:
        if k in data:
            return data[k]
    return None

def _load_calibration(path: str):
    ext = os.path.splitext(path)[-1].lower()
    if ext == ".npz":
        data = dict(np.load(path))
        K = np.array(_find_key(data, _KEY_K), dtype=np.float64)
        D = np.array(_find_key(data, _KEY_D), dtype=np.float64)
    elif ext == ".json":
        with open(path) as f:
            data = json.load(f)
        K = np.array(_find_key(data, _KEY_K), dtype=np.float64)
        D = np.array(_find_key(data, _KEY_D), dtype=np.float64)
    else:
        raise ValueError(f"Formato no soportado: '{ext}'")
    if K is None or D is None:
        raise KeyError(f"Claves de calibración no encontradas en '{path}'")
    return K.reshape(3, 3), D.flatten()

def _auto_find_calib(script_dir: str):
    for name in ["camera_params.npz", "camera_params.json"]:
        p = os.path.join(script_dir, name)
        if os.path.isfile(p):
            return p
    return None

# ─────────────────────────────────────────────────────────────────────
# Pose
# ─────────────────────────────────────────────────────────────────────
def _to_posestamped(rvec, tvec) -> PoseStamped:
    pose = PoseStamped()
    pose.pose.position.x = float(tvec[0])
    pose.pose.position.y = float(tvec[1])
    pose.pose.position.z = float(tvec[2])
    R, _ = cv2.Rodrigues(rvec)
    trace = R[0,0] + R[1,1] + R[2,2]
    if trace > 0:
        s = 0.5/np.sqrt(trace+1.0); w=0.25/s
        x=(R[2,1]-R[1,2])*s; y=(R[0,2]-R[2,0])*s; z=(R[1,0]-R[0,1])*s
    elif R[0,0] > R[1,1] and R[0,0] > R[2,2]:
        s=2.0*np.sqrt(1.0+R[0,0]-R[1,1]-R[2,2])
        w=(R[2,1]-R[1,2])/s; x=0.25*s; y=(R[0,1]+R[1,0])/s; z=(R[0,2]+R[2,0])/s
    elif R[1,1] > R[2,2]:
        s=2.0*np.sqrt(1.0+R[1,1]-R[0,0]-R[2,2])
        w=(R[0,2]-R[2,0])/s; x=(R[0,1]+R[1,0])/s; y=0.25*s; z=(R[1,2]+R[2,1])/s
    else:
        s=2.0*np.sqrt(1.0+R[2,2]-R[0,0]-R[1,1])
        w=(R[1,0]-R[0,1])/s; x=(R[0,2]+R[2,0])/s; y=(R[1,2]+R[2,1])/s; z=0.25*s
    pose.pose.orientation.x = x
    pose.pose.orientation.y = y
    pose.pose.orientation.z = z
    pose.pose.orientation.w = w
    return pose

# ─────────────────────────────────────────────────────────────────────
class ArucoDetectorNode(Node):

    MARKER_SIZE = 0.20  # metros

    def __init__(self):
        super().__init__('aruco_detector')

        # ── Parámetros ────────────────────────────────────────────────
        self.declare_parameter('camera_topic',  '/camera/image_raw/compressed')
        self.declare_parameter('publish_image', True)
        self.declare_parameter('unknown_id',    -1)
        self.declare_parameter('calib_file',    '')
        self.declare_parameter('marker_size',   self.MARKER_SIZE)

        camera_topic     = self.get_parameter('camera_topic').value
        self.marker_size = float(self.get_parameter('marker_size').value)

        # ── Calibración ───────────────────────────────────────────────
        self.camera_matrix = None
        self.dist_coeffs   = None
        self.pose_ready    = False

        script_dir = os.path.dirname(os.path.abspath(__file__))
        calib_file = self.get_parameter('calib_file').value or \
                     _auto_find_calib(script_dir)

        if calib_file:
            try:
                self.camera_matrix, self.dist_coeffs = _load_calibration(calib_file)
                self.pose_ready = True
                self.get_logger().info(
                    f"Calibración OK: '{calib_file}' | marker={self.marker_size}m"
                )
            except Exception as e:
                self.get_logger().warn(f"Calibración fallida: {e} → Pose DESACTIVADA")
        else:
            self.get_logger().warn("Sin calibración → Pose DESACTIVADA")

        # ── Detectores ────────────────────────────────────────────────
        self.bridge        = CvBridge()
        self.det_internal  = self._build_internal_detector()
        self.det_external  = self._build_external_detector()
        self.det_6x6       = self._build_6x6_detector()
        self.qr_detector   = cv2.QRCodeDetector()

        # ── QoS ───────────────────────────────────────────────────────
        qos_cam = QoSProfile(
            reliability=ReliabilityPolicy.BEST_EFFORT,
            history=HistoryPolicy.KEEP_LAST,
            depth=10
        )

        # ── Suscriptor ────────────────────────────────────────────────
        self.create_subscription(CompressedImage, camera_topic,
                                 self.image_callback, qos_cam)

        # ── Publicadores ──────────────────────────────────────────────
        self.pub_id       = self.create_publisher(Int32,       '/aruco/id',       10)
        self.pub_label    = self.create_publisher(String,      '/aruco/label',    10)
        self.pub_image    = self.create_publisher(Image,       '/aruco/imagen',   10)
        self.pub_waypoint = self.create_publisher(PoseStamped, '/aruco/waypoint', 10)
        self.pub_qr       = self.create_publisher(String,      '/aruco/qr',       10)

        self._prev_key  = None
        self._prev_qr   = ""

        self.get_logger().info(
            f"ArUco Triple-Dict + QR listo | topic: {camera_topic}\n"
            f"  16h3 → IDs 11-13  |  4X4_50 → IDs 20-23  "
            f"|  6X6_50 (WP0-6) → IDs 30-36  |  QR → /aruco/qr"
        )

    # ─────────────────────────────────────────────────────────────────
    # Construcción de detectores
    # ─────────────────────────────────────────────────────────────────

    def _load_custom_yaml(self):
        tmp = tempfile.NamedTemporaryFile(mode="w", suffix=".yaml", delete=False)
        tmp.write(CUSTOM_16H3_YAML)
        tmp.close()
        try:
            d  = cv2.aruco.Dictionary()
            fs = cv2.FileStorage(tmp.name, cv2.FILE_STORAGE_READ)
            d.readDictionary(fs.root())
            fs.release()
        finally:
            os.unlink(tmp.name)
        return d

    def _build_internal_detector(self):
        d = self._load_custom_yaml()
        return cv2.aruco.ArucoDetector(d, cv2.aruco.DetectorParameters())

    def _build_external_detector(self):
        d = cv2.aruco.getPredefinedDictionary(cv2.aruco.DICT_4X4_50)
        return cv2.aruco.ArucoDetector(d, cv2.aruco.DetectorParameters())

    def _build_6x6_detector(self):
        d = cv2.aruco.getPredefinedDictionary(cv2.aruco.DICT_6X6_50)
        return cv2.aruco.ArucoDetector(d, cv2.aruco.DetectorParameters())

    # ─────────────────────────────────────────────────────────────────
    # Detección
    # ─────────────────────────────────────────────────────────────────

    def _detect_all(self, frame):
        """
        Retorna:
            internal_hits : list of (orig_id, corner)
            external_hits : list of (marker_id, corner)
            wp6x6_hits    : list of (marker_id, corner)   ← solo IDs 0-6
            qr_data       : str  (vacío si no hay QR)
        """
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

        c_int, ids_int, _ = self.det_internal.detectMarkers(gray)
        c_ext, ids_ext, _ = self.det_external.detectMarkers(gray)
        c_6x6, ids_6x6, _ = self.det_6x6.detectMarkers(gray)
        qr_data, _, _     = self.qr_detector.detectAndDecode(frame)

        internal_hits = []
        if ids_int is not None:
            for i, idx in enumerate(ids_int.flatten()):
                orig_id = ID_ORDER_INTERNAL[int(idx)]
                internal_hits.append((orig_id, c_int[i]))

        external_hits = []
        if ids_ext is not None:
            for i, mid in enumerate(ids_ext.flatten()):
                external_hits.append((int(mid), c_ext[i]))

        wp6x6_hits = []
        if ids_6x6 is not None:
            for i, mid in enumerate(ids_6x6.flatten()):
                if int(mid) in WAYPOINT_6X6_IDS:
                    wp6x6_hits.append((int(mid), c_6x6[i]))

        return internal_hits, external_hits, wp6x6_hits, qr_data or ""

    # ─────────────────────────────────────────────────────────────────
    # Pose
    # ─────────────────────────────────────────────────────────────────

    def _estimate_pose(self, corner):
        if not self.pose_ready:
            return None, None
        half = self.marker_size / 2.0
        obj_pts = np.array([
            [-half,  half, 0], [ half,  half, 0],
            [ half, -half, 0], [-half, -half, 0],
        ], dtype=np.float32)
        ok, rvec, tvec = cv2.solvePnP(
            obj_pts, corner[0].astype(np.float32),
            self.camera_matrix, self.dist_coeffs,
            flags=cv2.SOLVEPNP_IPPE_SQUARE
        )
        return (rvec.flatten(), tvec.flatten()) if ok else (None, None)

    def _publish_pose(self, corner, stamp):
        rv, tv = self._estimate_pose(corner)
        if rv is not None:
            pm = _to_posestamped(rv, tv)
            pm.header.stamp    = stamp
            pm.header.frame_id = 'camera_optical_frame'
            self.pub_waypoint.publish(pm)
            return tv
        return None

    # ─────────────────────────────────────────────────────────────────
    # Anotación visual
    # ─────────────────────────────────────────────────────────────────

    def _draw_marker(self, out, corner, label, color, rvec=None, tvec=None):
        pts = corner[0].astype(int)
        cx  = int(pts[:, 0].mean())
        cy  = int(pts[:, 1].mean())
        cv2.polylines(out, [pts], True, color, 2)

        if rvec is not None and self.pose_ready:
            cv2.drawFrameAxes(out, self.camera_matrix, self.dist_coeffs,
                              rvec, tvec, self.marker_size * 0.5)
            label += f" [{np.linalg.norm(tvec):.2f}m]"

        (tw, th), _ = cv2.getTextSize(label, cv2.FONT_HERSHEY_SIMPLEX, 0.55, 2)
        cv2.rectangle(out, (cx-5, cy-th-8), (cx+tw+5, cy+4), (0,0,0), -1)
        cv2.putText(out, label, (cx, cy),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.55, color, 2, cv2.LINE_AA)

    def _draw_qr(self, out, frame, qr_data: str):
        """Dibuja el bbox del QR y su contenido si fue detectado."""
        retval, points = self.qr_detector.detect(frame)
        if retval and points is not None:
            pts = points[0].astype(int)
            cv2.polylines(out, [pts], True, (255, 0, 255), 2)
            cx = int(pts[:, 0].mean())
            cy = int(pts[:, 1].mean())
            label = f"QR: {qr_data[:30]}" if qr_data else "QR"
            (tw, th), _ = cv2.getTextSize(label, cv2.FONT_HERSHEY_SIMPLEX, 0.55, 2)
            cv2.rectangle(out, (cx-5, cy-th-8), (cx+tw+5, cy+4), (0,0,0), -1)
            cv2.putText(out, label, (cx, cy),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.55, (255, 0, 255), 2, cv2.LINE_AA)

    def _annotate(self, frame, internal_hits, external_hits,
                  wp6x6_hits, qr_data, poses_int, poses_ext, poses_6x6):
        out = frame.copy()

        for i, (orig_id, corner) in enumerate(internal_hits):
            rv, tv = poses_int[i]
            self._draw_marker(out, corner, LABEL_INTERNAL[orig_id],
                              (0, 255, 0), rv, tv)

        for i, (mid, corner) in enumerate(external_hits):
            rv, tv = poses_ext[i]
            self._draw_marker(out, corner, LABEL_EXTERNAL.get(mid, f"Ext {mid}"),
                              (0, 215, 255), rv, tv)

        for i, (mid, corner) in enumerate(wp6x6_hits):
            rv, tv = poses_6x6[i]
            self._draw_marker(out, corner, label_6x6(mid),
                              (255, 128, 0), rv, tv)   # naranja

        if qr_data:
            self._draw_qr(out, frame, qr_data)

        return out

    # ─────────────────────────────────────────────────────────────────
    # Callback principal
    # ─────────────────────────────────────────────────────────────────

    def image_callback(self, msg: CompressedImage):
        try:
            np_arr = np.frombuffer(msg.data, dtype=np.uint8)
            frame  = cv2.imdecode(np_arr, cv2.IMREAD_COLOR)
            if frame is None:
                raise ValueError("imdecode devolvió None")
        except Exception as e:
            self.get_logger().error(f"Error decodificando imagen: {e}")
            return

        internal_hits, external_hits, wp6x6_hits, qr_data = \
            self._detect_all(frame)

        unknown_id = self.get_parameter('unknown_id').value

        # Estimar poses
        poses_int  = [self._estimate_pose(c) for _, c in internal_hits]
        poses_ext  = [self._estimate_pose(c) for _, c in external_hits]
        poses_6x6  = [self._estimate_pose(c) for _, c in wp6x6_hits]

        # ── QR ────────────────────────────────────────────────────────
        if qr_data and qr_data != self._prev_qr:
            self.pub_qr.publish(String(data=qr_data))
            self.get_logger().info(f"  [QR] {qr_data}")
            self._prev_qr = qr_data
        elif not qr_data and self._prev_qr:
            self._prev_qr = ""

        # ── ArUcos ────────────────────────────────────────────────────
        any_aruco = internal_hits or external_hits or wp6x6_hits

        if any_aruco:
            # Prioridad: interno > externo > 6x6
            if internal_hits:
                orig_id = internal_hits[0][0]
                pub_id  = internal_pub_id(orig_id)
                label   = LABEL_INTERNAL[orig_id]
            elif external_hits:
                mid    = external_hits[0][0]
                pub_id = external_pub_id(mid)
                label  = LABEL_EXTERNAL.get(mid, f"Ext {mid}")
            else:
                mid    = wp6x6_hits[0][0]
                pub_id = waypoint_pub_id(mid)
                label  = label_6x6(mid)

            self.pub_id.publish(Int32(data=pub_id))
            self.pub_label.publish(String(data=label))

            # Publicar poses
            for i, (orig_id, corner) in enumerate(internal_hits):
                rv, tv = poses_int[i]
                if rv is not None:
                    pm = _to_posestamped(rv, tv)
                    pm.header.stamp    = msg.header.stamp
                    pm.header.frame_id = 'camera_optical_frame'
                    self.pub_waypoint.publish(pm)

            for i, (mid, corner) in enumerate(external_hits):
                rv, tv = poses_ext[i]
                if rv is not None:
                    pm = _to_posestamped(rv, tv)
                    pm.header.stamp    = msg.header.stamp
                    pm.header.frame_id = 'camera_optical_frame'
                    self.pub_waypoint.publish(pm)

            for i, (mid, corner) in enumerate(wp6x6_hits):
                rv, tv = poses_6x6[i]
                if rv is not None:
                    pm = _to_posestamped(rv, tv)
                    pm.header.stamp    = msg.header.stamp
                    pm.header.frame_id = 'camera_optical_frame'
                    self.pub_waypoint.publish(pm)

            # Log (solo cuando cambia)
            curr_key = (
                tuple(sorted(h[0] for h in internal_hits)),
                tuple(sorted(h[0] for h in external_hits)),
                tuple(sorted(h[0] for h in wp6x6_hits)),
            )
            if curr_key != self._prev_key:
                for i, (orig_id, _) in enumerate(internal_hits):
                    rv, tv = poses_int[i]
                    d = f" | dist={np.linalg.norm(tv):.3f}m" if tv is not None else ""
                    self.get_logger().info(
                        f"  [INT] {LABEL_INTERNAL[orig_id]}"
                        f" → pub_id={internal_pub_id(orig_id)}{d}"
                    )
                for i, (mid, _) in enumerate(external_hits):
                    rv, tv = poses_ext[i]
                    d = f" | dist={np.linalg.norm(tv):.3f}m" if tv is not None else ""
                    self.get_logger().info(
                        f"  [EXT] {LABEL_EXTERNAL.get(mid, f'Ext {mid}')}"
                        f" → pub_id={external_pub_id(mid)}{d}"
                    )
                for i, (mid, _) in enumerate(wp6x6_hits):
                    rv, tv = poses_6x6[i]
                    d = f" | dist={np.linalg.norm(tv):.3f}m" if tv is not None else ""
                    self.get_logger().info(
                        f"  [WP]  {label_6x6(mid)}"
                        f" → pub_id={waypoint_pub_id(mid)}{d}"
                    )
                self._prev_key = curr_key

        else:
            self.pub_id.publish(Int32(data=unknown_id))
            self.pub_label.publish(String(data=""))
            if self._prev_key not in (None, ((), (), ())):
                self.get_logger().info("  (sin marcadores)")
            self._prev_key = ((), (), ())

        # ── Imagen anotada ────────────────────────────────────────────
        if self.get_parameter('publish_image').value:
            annotated = self._annotate(
                frame, internal_hits, external_hits, wp6x6_hits,
                qr_data, poses_int, poses_ext, poses_6x6
            )
            ann_msg = self.bridge.cv2_to_imgmsg(annotated, encoding='bgr8')
            ann_msg.header = msg.header
            self.pub_image.publish(ann_msg)


# ─────────────────────────────────────────────────────────────────────
def main(args=None):
    rclpy.init(args=args)
    node = ArucoDetectorNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()