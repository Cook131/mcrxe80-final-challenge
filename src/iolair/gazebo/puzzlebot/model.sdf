<?xml version='1.0'?>
<sdf version='1.6'>
  <model name='puzzlebot1'>

    <!-- ── Chassis ─────────────────────────────────────────────────────── -->
    <link name='chassis'>
      <pose>0 0 0.05 0 0 0</pose>

      <inertial>
        <mass>0.8</mass>
        <pose>-0.05 0 0 0 0 0</pose>
        <inertia>
          <ixx>0.004</ixx><iyy>0.004</iyy><izz>0.004</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name='visual'>
        <geometry><mesh><uri>model://puzzlebot/meshes/chassis1.dae</uri></mesh></geometry>
      </visual>

      <collision name='collision'>
        <pose>-0.055 0 0 0 0 0</pose>
        <geometry><box><size>0.2 0.16 0.046</size></box></geometry>
      </collision>

      <!-- Camera sensor (classic Gazebo) -->
      <sensor type='camera' name='camera_sensor'>
        <pose>0.05 0 0.11 0 0 0</pose>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>100</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <plugin name='camera_controller' filename='libgazebo_ros_camera.so'>
          <alwaysOn>true</alwaysOn>
          <updateRate>10</updateRate>
          <cameraName>camera</cameraName>
          <imageTopicName>/camera</imageTopicName>
          <cameraInfoTopicName>/camera_info</cameraInfoTopicName>
          <frameName>camera_link</frameName>
        </plugin>
      </sensor>

      <!-- LiDAR sensor (classic Gazebo — gpu_ray falls back to ray) -->
      <sensor name='gpu_lidar' type='ray'>
        <pose>0 0 0.14 0 0 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>90</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.14159265</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.08</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
        </ray>
        <always_on>1</always_on>
        <update_rate>5</update_rate>
        <visualize>true</visualize>
        <plugin name='lidar_plugin' filename='libgazebo_ros_ray_sensor.so'>
          <ros>
            <remapping>~/out:=/lidar</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>lidar_link</frame_name>
        </plugin>
      </sensor>

    </link>

    <!-- ── Right wheel ──────────────────────────────────────────────────── -->
    <link name='right_wheel'>
      <pose>0.0 -0.095 0.05 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name='visual'>
        <geometry><mesh><uri>model://puzzlebot/meshes/wheel.dae</uri></mesh></geometry>
      </visual>
      <collision name='collision'>
        <pose>0 -0.0025 0 1.5707 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.005</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>

    <!-- ── Left wheel ───────────────────────────────────────────────────── -->
    <link name='left_wheel'>
      <pose>0.0 0.095 0.05 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name='visual'>
        <geometry><mesh><uri>model://puzzlebot/meshes/wheel.dae</uri></mesh></geometry>
      </visual>
      <collision name='collision'>
        <pose>0 -0.0025 0 1.5707 0 0</pose>
        <geometry><cylinder><radius>0.05</radius><length>0.005</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
    </link>

    <!-- ── Caster ───────────────────────────────────────────────────────── -->
    <link name='caster'>
      <pose>-0.145 0 0.006 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.0000025</ixx><iyy>0.0000025</iyy><izz>0.0000025</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <visual name='visual'>
        <geometry><sphere><radius>0.006</radius></sphere></geometry>
        <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
      </visual>
      <collision name='collision'>
        <geometry><sphere><radius>0.006</radius></sphere></geometry>
      </collision>
    </link>

    <!-- ── Joints ───────────────────────────────────────────────────────── -->
    <joint name='left_wheel_joint' type='revolute'>
      <parent>chassis</parent><child>left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1</effort></limit>
        <dynamics><friction>0.1</friction></dynamics>
      </axis>
    </joint>

    <joint name='right_wheel_joint' type='revolute'>
      <parent>chassis</parent><child>right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper><effort>1</effort></limit>
        <dynamics><friction>0.1</friction></dynamics>
      </axis>
    </joint>

    <joint name='caster_wheel' type='ball'>
      <parent>chassis</parent><child>caster</child>
    </joint>

    <!-- ── ROS2-native differential drive plugin ──────────────────────── -->
    <!-- libgazebo_ros_diff_drive is built into gazebo_ros and uses ROS2    -->
    <!-- transport natively — no bridge needed. It reads /cmd_vel (Twist)   -->
    <!-- and publishes /odom + odom→base_link TF directly.                  -->
    <plugin name='diff_drive' filename='libgazebo_ros_diff_drive.so'>
      <ros>
        <namespace>/</namespace>
      </ros>

      <!-- Joints -->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <!-- Kinematics — must match physical model -->
      <wheel_separation>0.19</wheel_separation>
      <wheel_diameter>0.10</wheel_diameter>

      <!-- Limits -->
      <max_wheel_torque>1.0</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>

      <!-- Topics -->
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>

      <!-- Publish odom→base_link TF from the plugin directly -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>

      <update_rate>100</update_rate>
    </plugin>

  </model>
</sdf>