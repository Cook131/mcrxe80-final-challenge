          <material><ambient>0.75 0.75 0.75 1</ambient></material></visual>
      </link>
    </model>

    <model name="door_lintel_1">
      <static>true</static><pose>2.30 0.80 0.70 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 0.4 0.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 0.4 0.2</size></box></geometry>
