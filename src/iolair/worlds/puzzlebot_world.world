    <!-- ══ ROBOT — incluido via GAZEBO_MODEL_PATH ══ -->
    <include>
      <uri>model://puzzlebot</uri>
      <name>puzzlebot1</name>
      <pose>0.0 0.0 0.05 0 0 0</pose>
