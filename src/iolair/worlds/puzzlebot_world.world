<?xml version="1.0"?>
<sdf version="1.6">
  <world name="puzzlebot_world">

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <physics type="ode">
      <max_step_size>0.005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <!-- ══ PAREDES EXTERIORES ══ -->
    <model name="wall_north">
      <static>true</static><pose>0 1.45 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>4.5 0.1 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.5 0.1 0.8</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient></material></visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static><pose>0 -1.45 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>4.5 0.1 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>4.5 0.1 0.8</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient></material></visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static><pose>-2.30 0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 2.8 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 2.8 0.8</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient></material></visual>
      </link>
    </model>

    <!-- ══ PARED ESTE — 4 segmentos + 3 dinteles ══ -->
    <model name="wall_east_seg1">
      <static>true</static><pose>2.30 1.20 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 0.4 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 0.4 0.8</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient></material></visual>
      </link>
    </model>

    <model name="wall_east_seg2">
      <static>true</static><pose>2.30 0.40 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 0.4 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 0.4 0.8</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient></material></visual>
      </link>
    </model>

    <model name="wall_east_seg3">
      <static>true</static><pose>2.30 -0.40 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 0.4 0.8</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 0.4 0.8</size></box></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient></material></visual>
