    <!-- ══ BLOQUES NORTE — 5 bloques ══ -->
    <model name="block_north_1"><static>true</static><pose>-1.80 1.15 0.075 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.28 0.28 0.30</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.28 0.28 0.30</size></box></geometry>
          <material><ambient>0.8 0.3 0.7 1</ambient></material></visual>
      </link>
    </model>

    <model name="block_north_2"><static>true</static><pose>-1.45 1.15 0.075 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.28 0.28 0.30</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.28 0.28 0.30</size></box></geometry>
