        <visual name="v"><geometry><box><size>0.28 0.28 0.30</size></box></geometry>
          <material><ambient>0.3 0.3 0.7 1</ambient></material></visual>
      </link>
    </model>

    <!-- ══ BLOQUES CENTRO — mas chicos y separados ══ -->
    <model name="block_center_left_top">
      <static>true</static><pose>-0.70 0.85 0.075 0 0 0</pose>
      <link name="link">
